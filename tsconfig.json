{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["*.ts", "*/**/*.ts"],
  "exclude": [
    "node_modules", "**/node_modules", "**/tests", "mockups", "pi-chat.ts",
    "agentic-flow", "claude-auth", "dot-clean", "pdf", "session-cleanup", "thinking-toggle"
  ]
}
